# ---------------------------------------------------------------------------
# Pot Stories — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# With NO Supabase/Razorpay values set, the app runs in clearly labelled
# DEMO MODE: a local JSON database in .data/ and a demo checkout (no payment).
# ---------------------------------------------------------------------------

# Public site URL (used for auth redirect links and Razorpay callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (enables the production backend when both public values are set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (TEST MODE). Payments stay in demo mode until both are set.
# Use keys starting with rzp_test_. Live keys are refused unless RAZORPAY_ALLOW_LIVE=true
# (only after business approval).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay dashboard for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false

# --- Read-only online preview (e.g. Vercel without Supabase)
# On Vercel (VERCEL=1, set automatically) the local JSON demo database cannot
# persist, so the demo backend becomes browse-only: catalogue, search, filters,
# bag and wishlist (in the browser) work; accounts, checkout, newsletter and admin
# are switched off with a visible notice. Force it locally with DEMO_READ_ONLY=true.
DEMO_READ_ONLY=

# --- Local demo backend only (ignored when Supabase is configured)
# HMAC secret for the demo session cookie (any long random string).
SESSION_SECRET=
# Seeds a local admin account for testing /admin in demo mode.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# --- Sample delivery pricing for the preview (business rules to be confirmed)
DELIVERY_FEE=99
FREE_DELIVERY_THRESHOLD=999
